# Names only. Real values live in Vercel (Production, Preview, Development)
# and are pulled into .env.local with `vercel env pull .env.local`.
# Never commit real values.

# Server only (secret): the AI steps
ANTHROPIC_API_KEY=

# Browser (public): event tracking, PostHog US Cloud
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Browser (public): Supabase project URL and publishable key (sb_publishable_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only (secret): Supabase secret key (sb_secret_). Never import it in client code
SUPABASE_SERVICE_ROLE_KEY=
